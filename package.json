{
    "name": "svelt-stores-test",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:api": "vitest run src/tests/NodeBlueprintAPI.test.ts",
        "test:nodeblueprint": "vitest run src/lib/compositor/nodes/firestore/FirestoreNodeBluePrint.test.ts",
        "test:nodeblueprintstress": "vitest run src/tests/NodeBlueprintStress.test.ts",
        "test:bigdata": "vitest run src/lib/compositor/BigData.test.ts src/routes/app/compositor/BigDataCleanup.test.ts",
        "test:quick": "vitest run src/tests/QuickAPITest.test.ts",
        "test:all-api": "vitest run src/tests/",
        "emulators": "firebase emulators:start",
        "kill-emulators": "node scripts/kill-emulators.js",
        "deploy": "yarn run build; firebase deploy",
        "format": "prettier --write '{src/**/*,*}.{js,ts,vue,json}'"
    },
    "devDependencies": {
        "@eslint/compat": "^1.2.5",
        "@eslint/js": "^9.18.0",
        "@sveltejs/kit": "^2.16.0",
        "@sveltejs/package": "^2.0.0",
        "@sveltejs/vite-plugin-svelte": "^5.0.0",
        "@tailwindcss/forms": "^0.5.9",
        "@tailwindcss/typography": "^0.5.15",
        "@tailwindcss/vite": "^4.1.8",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/svelte": "^5.2.4",
        "@types/marked": "^6.0.0",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-svelte": "^3.0.0",
        "flowbite": "^3.1.2",
        "flowbite-svelte": "^1.5.0",
        "flowbite-svelte-icons": "^2.2.0",
        "globals": "^16.0.0",
        "graphology": "^0.26.0",
        "graphology-dag": "^0.4.1",
        "jsdom": "^26.0.0",
        "prettier": "^3.4.2",
        "prettier-plugin-svelte": "^3.3.3",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "svelte": "^5.0.0",
        "svelte-adapter-firebase": "^0.15.0",
        "svelte-check": "^4.0.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.0.0",
        "typescript-eslint": "^8.20.0",
        "vite": "^6.2.6",
        "vitest": "^3.0.0"
    },
    "dependencies": {
        "@gradio/client": "^1.15.0",
        "@sveltejs/adapter-static": "^3.0.8",
        "@tensorflow/tfjs": "^4.22.0",
        "@xyflow/svelte": "^1.0.2",
        "elkjs": "^0.10.0",
        "firebase": "^11.8.1",
        "jimp": "^1.6.0",
        "lucide-svelte": "^0.511.0",
        "marked": "^15.0.12",
        "sveltefire": "^0.4.5",
        "uuid": "^11.1.0"
    },
    "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}

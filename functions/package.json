{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "genkitdevui": "source .env && export GEMINI_API_KEY=$GOOGLE_GENAI_API_KEY && genkit start -p 4001 -- npx tsx --watch src/index.ts",
    "logs": "firebase functions:log",
    "test": "mocha",
    "test:watch": "mocha --watch",
    "test:unit": "mocha --require ts-node/register src/test/*.test.ts"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@genkit-ai/firebase": "^1.13.0",
    "@genkit-ai/googleai": "^1.13.0",
    "@types/cors": "^2.8.19",
    "@types/uuid": "^10.0.0",
    "axios": "^1.9.0",
    "cors": "^2.8.5",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.0.1",
    "genkit": "^1.13.0",
    "langchain": "^0.3.28",
    "together-ai": "^0.16.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/sinon": "^17.0.4",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "chai": "^5.2.0",
    "dotenv": "^16.5.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.1.0",
    "mocha": "^11.6.0",
    "sinon": "^19.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.0"
  },
  "private": true
}

{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "npm run build && mocha lib/test/**/*.js --timeout 10000",
    "test:watch": "npm run build:watch & mocha lib/test/**/*.js --watch --timeout 10000",
    "test:comprehensive": "npm run build && mocha lib/test/comprehensive-api.test.js --timeout 30000",
    "test:stress": "npm run build && mocha lib/test/stress-tests.test.js --timeout 300000",
    "test:quick-stress": "npm run build && mocha lib/test/quick-stress.test.js --timeout 60000",
    "test:basic": "npm run build && mocha lib/test/simple.test.js --timeout 10000"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.0.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "chai": "^5.2.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.1.0",
    "mocha": "^11.6.0",
    "typescript": "^4.9.0"
  },
  "private": true
}
